# ================= TaskFlow AI 配置 =================
# 复制为 .env 后按需修改；未设置的项使用 docker-compose.yml 里的默认值

# ---- LLM 通道：mock | ollama | openai ----
# mock    无需模型，演示流程用
# ollama  本地模型（默认，数据不出内网，适合企业部署）
# openai  OpenAI 兼容云 API（DeepSeek/GLM/GPT 等）
LLM_PROVIDER=ollama

# ---- ollama 通道 ----
# 容器内访问宿主机 Ollama 用 host.docker.internal；
# 如 Ollama 部署在别的机器，改成 http://<IP>:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:4b

# ---- openai 兼容通道（LLM_PROVIDER=openai 时生效）----
# DeepSeek 示例：
#   LLM_BASE_URL=https://api.deepseek.com/v1
#   LLM_MODEL=deepseek-chat
# 智谱 GLM 示例：
#   LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#   LLM_MODEL=glm-4-flash
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# LLM 请求超时（秒），本地小模型拆大项目建议 >= 180
LLM_TIMEOUT=180
